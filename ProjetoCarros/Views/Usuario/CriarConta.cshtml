@model ProjetoCarros.Models.Usuario
@{
    ViewData["Title"] = "Criar Conta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/logar.css" asp-append-version="true" />
}

<section class="logar-section">
    <div class="container">
        <h1 class="logar-titulo">CRIAR CONTA NA ETEC MOTORS</h1>
        <p class="logar-subtexto">Preencha os dados abaixo para começar</p>

        <form asp-action="CriarConta" method="post" class="logar-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger logar-erro"></div>

            <div class="logar-campo">
                <label asp-for="Nome" class="logar-label">NOME</label>
                <input asp-for="Nome" type="text" placeholder="Seu nome completo" class="logar-input" />
                <span asp-validation-for="Nome" class="text-danger logar-erro"></span>
            </div>

            <div class="logar-campo">
                <label asp-for="Email" class="logar-label">E-MAIL</label>
                <input asp-for="Email" type="email" placeholder="seu@email.com" class="logar-input" />
                <span asp-validation-for="Email" class="text-danger logar-erro"></span>
            </div>

            <div class="logar-campo">
                <label asp-for="Senha" class="logar-label">SENHA</label>
                <input asp-for="Senha" type="password" placeholder="Mínimo 6 caracteres" class="logar-input" />
                <span asp-validation-for="Senha" class="text-danger logar-erro"></span>
            </div>

            <button type="submit" class="logar-botao">CADASTRAR</button>

            <p class="logar-rodape">
                Já possui conta?
                <a asp-action="Logar" asp-controller="Usuario" class="logar-link">Entrar</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}