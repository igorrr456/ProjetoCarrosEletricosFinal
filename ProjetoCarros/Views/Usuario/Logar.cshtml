@model ProjetoCarros.Models.Usuario
@{
    ViewData["Title"] = "Logar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/logar.css" asp-append-version="true" />
}

<section class="logar-section">
    <div class="container">
        <h1 class="logar-titulo">ENTRAR NA ETEC MOTORS</h1>
        <p class="logar-subtexto">Bem-vindo de volta</p>

        <form asp-action="Logar" method="post" class="logar-form">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger logar-erro"></div>

            <div class="logar-campo">
                <label asp-for="Email" class="logar-label">E-MAIL</label>
                <input asp-for="Email" type="email" placeholder="seu@email.com" class="logar-input" />
                <span asp-validation-for="Email" class="text-danger logar-erro"></span>
            </div>

            <div class="logar-campo">
                <label asp-for="Senha" class="logar-label">SENHA</label>
                <input asp-for="Senha" type="password" placeholder="Sua senha" class="logar-input" />
                <span asp-validation-for="Senha" class="text-danger logar-erro"></span>
            </div>

            <button type="submit" class="logar-botao">ENTRAR</button>

            <p class="logar-rodape">
                Não possui conta?
                <a asp-action="CriarConta" asp-controller="Usuario" class="logar-link">Criar conta</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}