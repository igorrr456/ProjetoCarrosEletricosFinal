@model List<ProjetoCarros.Models.Carro>

@{
    ViewData["Title"] = "Todos os Modelos";
}
<link rel="stylesheet" href="~/css/Catalogo.css" />

<section class="cat-hero">
    <div class="container">
        <h1 class="cat-titulo">TODOS OS MODELOS</h1>
        <p class="cat-subtitulo">Conheça toda a linha de veículos disponíveis</p>
    </div>
</section>

<section class="cat-section">
    <div class="container">

        @if (Model != null && Model.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var carro in Model)
                {
                    <div class="col">
                        <article class="cat-card">
                            <div class="cat-card-img">
                                @if (!string.IsNullOrEmpty(carro.Imagem))
                                {
                                    <img src="@carro.Imagem" alt="@carro.Nome" />
                                }
                                else
                                {
                                    <div class="cat-card-placeholder">Sem imagem</div>
                                }
                                <span class="cat-badge">@carro.Categoria</span>
                            </div>

                            <div class="cat-card-body">
                                <span class="cat-marca">@carro.Marca</span>
                                <span class="cat-nome">@carro.Nome</span>
                                @if (!string.IsNullOrEmpty(carro.Descricao))
                                {
                                    <p class="cat-desc">@carro.Descricao</p>
                                }
                                <p class="cat-preco">R$ @carro.Preco.ToString("N2")<span>ou 48x sem juros</span></p>
                            </div>

                            <form asp-action="Comprar" asp-controller="Carros" method="post" class="cat-card-acao">
                                <input type="hidden" name="id" value="@carro.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="cat-btn-comprar">
                                    Comprar
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </form>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="cat-vazio">
                <p>Nenhum carro disponível no momento</p>
            </div>
        }

    </div>
</section>